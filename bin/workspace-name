#!/usr/bin/env bash
# workspace-name — give the current Hyprland workspace a title.
#
# The Omarchy bar keeps showing the plain number; the nixfred.workspace-names
# shell plugin slides the title in under it whenever you switch workspaces.
# Names are stored in ~/.config/omarchy/workspace-names.json.
#
# Usage:
#   workspace-name               open the inline editor under the bar number
#                                (falls back to an Omarchy menu prompt)
#   workspace-name NAME...       set the name directly
#   workspace-name -c|--clear    remove the name
#   workspace-name -l|--list     print all names
#   workspace-name -p|--peek     just flash the overlay
#   workspace-name -i N ...      act on workspace N instead of the focused one
#   workspace-name -u|--if-unset NAME
#                                set the name only if that workspace has none,
#                                and flash nothing
#   workspace-name -a|--auto NAME
#                                set the name if that workspace has none or its
#                                current name was written automatically; never
#                                touch a typed name; flash nothing (the
#                                automatic naming path)
set -euo pipefail

FILE="${WORKSPACE_NAMES_FILE:-$HOME/.config/omarchy/workspace-names.json}"
PLUGIN="nixfred.workspace-names"

usage() { sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//' >&2; }

for c in hyprctl jq flock; do command -v "$c" >/dev/null || { echo "workspace-name: $c not found" >&2; exit 1; }; done

ws=""
mode="set"
if_unset=0
if_auto=0
while (($#)); do
  case "$1" in
    -i|--id) ws="${2:-}"; shift 2 ;;
    -u|--if-unset) if_unset=1; shift ;;
    -a|--auto) if_auto=1; shift ;;
    -c|--clear) mode="clear"; shift ;;
    -l|--list) mode="list"; shift ;;
    -p|--peek) mode="peek"; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) echo "workspace-name: unknown option $1" >&2; usage; exit 2 ;;
    *) break ;;
  esac
done

[[ -s $FILE ]] || { mkdir -p "$(dirname "$FILE")"; printf '{}\n' > "$FILE"; }
jq -e 'type == "object"' "$FILE" >/dev/null 2>&1 || { echo "workspace-name: $FILE is not a JSON object" >&2; exit 1; }

if [[ $mode == list ]]; then
  jq -r 'to_entries | map(select(.key | startswith("_") | not)) | sort_by(.key | tonumber? // 9999)[] | "\(.key)\t\(.value)"' "$FILE"
  exit 0
fi

[[ -n $ws ]] || ws=$(hyprctl activeworkspace -j | jq -r '.id')
[[ $ws =~ ^[0-9]+$ ]] || { echo "workspace-name: bad workspace id '$ws'" >&2; exit 1; }

peek() { omarchy-shell -q "$PLUGIN" showId "$ws" || true; }

if [[ $mode == peek ]]; then peek; exit 0; fi

write() { # $1 = jq filter
  # Share Plonk's directory lock, then read the latest JSON. Atomic rename
  # alone doesn't protect against losing another writer's concurrent update.
  local state_dir="${PLONK_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/plonk}"
  [[ ! -L $state_dir ]] || { echo 'workspace-name: refusing a symlinked Plonk state directory' >&2; return 1; }
  mkdir -p -m 700 "$state_dir"
  exec 8<"$state_dir"
  if ! flock -w 3 8; then
    exec 8>&-
    echo 'workspace-name: Plonk is busy; try saving again' >&2
    return 1
  fi
  local tmp; tmp=$(mktemp "${FILE}.XXXXXX")
  # `autolist` is the set of workspaces whose current name was written
  # automatically, after the app they ran. Plonk reads it to decide what may be
  # overwritten: a name you TYPED outranks one a suggestion wrote, wherever the
  # two meet. `tidy` drops the key again once it is empty.
  jq --arg id "$ws" --arg name "${name:-}" \
     'def autolist: (if (._auto | type) == "array" then ._auto else [] end);
      def tidy: if (._auto | length) == 0 then del(._auto) else . end;
      '"$1" "$FILE" > "$tmp" && mv "$tmp" "$FILE"
  local status=$?
  [[ ! -e $tmp ]] || rm -f "$tmp"
  exec 8>&-
  return "$status"
}

if [[ $mode == clear ]]; then
  write 'del(.[$id]) | ._auto = (autolist - [$id]) | tidy'
  peek
  exit 0
fi

if (($#)); then
  name="$*"
else
  # Preferred: the bar widget's inline editor (hover the number → click the
  # chip does the same). Returns "ok" only when the widget is live in the bar.
  if [[ $(omarchy-shell "$PLUGIN.bar" edit "$ws" 2>/dev/null) == ok ]]; then
    exit 0
  fi
  current=$(jq -r --arg id "$ws" '.[$id] // ""' "$FILE")
  prompt="Name workspace $ws"
  [[ -n $current ]] && prompt+=" (now: $current, empty clears)"
  if ! name=$(omarchy-menu-input "$prompt" --width 420); then
    exit 0 # cancelled
  fi
fi

name="${name#"${name%%[![:space:]]*}"}"; name="${name%"${name##*[![:space:]]}"}"
if ((if_auto)); then
  # Automatic naming: the name follows the app. A slot that is empty or whose
  # name was itself written automatically takes the new name; a name you TYPED
  # is never touched. The test and the write happen inside the same lock, so a
  # typed name that landed while this was in flight wins. Silent: an automatic
  # name must not flash the popup.
  [[ -n $name ]] || exit 0
  write 'if ((.[$id] | type) == "string" and (.[$id] | test("\\S"))
            and ((autolist | index($id)) == null))
         then . else .[$id] = $name | ._auto = ((autolist + [$id]) | unique) end'
  exit 0
fi
if ((if_unset)); then
  # Automatic naming: claim the slot only if nothing holds it. The test and
  # the write happen inside the same lock, so the first writer wins and a name
  # you typed is never overwritten by a suggestion that was in flight. Silent:
  # an automatic name must not flash the popup.
  [[ -n $name ]] || exit 0
  write 'if ((.[$id] | type) == "string" and (.[$id] | test("\\S")))
         then . else .[$id] = $name | ._auto = ((autolist + [$id]) | unique) end'
  exit 0
fi
if [[ -z $name ]]; then
  write 'del(.[$id]) | ._auto = (autolist - [$id]) | tidy'
else
  # Typed by hand: the slot stops being automatic, so nothing overwrites it.
  write '.[$id] = $name | ._auto = (autolist - [$id]) | tidy'
fi
peek
