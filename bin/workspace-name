#!/usr/bin/env bash
# workspace-name — give the current Hyprland workspace a title.
#
# The Omarchy bar keeps showing the plain number; the nixfred.workspace-names
# shell plugin slides the title in under it whenever you switch workspaces.
# Names are stored in ~/.config/omarchy/workspace-names.json.
#
# Usage:
#   workspace-name               open the inline editor under the bar number
#                                (falls back to an Omarchy menu prompt)
#   workspace-name NAME...       set the name directly
#   workspace-name -c|--clear    remove the name
#   workspace-name -l|--list     print all names
#   workspace-name -p|--peek     just flash the overlay
#   workspace-name -i N ...      act on workspace N instead of the focused one
set -euo pipefail

FILE="${WORKSPACE_NAMES_FILE:-$HOME/.config/omarchy/workspace-names.json}"
PLUGIN="nixfred.workspace-names"

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' >&2; }

for c in hyprctl jq; do command -v "$c" >/dev/null || { echo "workspace-name: $c not found" >&2; exit 1; }; done

ws=""
mode="set"
while (($#)); do
  case "$1" in
    -i|--id) ws="${2:-}"; shift 2 ;;
    -c|--clear) mode="clear"; shift ;;
    -l|--list) mode="list"; shift ;;
    -p|--peek) mode="peek"; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) echo "workspace-name: unknown option $1" >&2; usage; exit 2 ;;
    *) break ;;
  esac
done

[[ -s $FILE ]] || { mkdir -p "$(dirname "$FILE")"; printf '{}\n' > "$FILE"; }
jq -e 'type == "object"' "$FILE" >/dev/null 2>&1 || { echo "workspace-name: $FILE is not a JSON object" >&2; exit 1; }

if [[ $mode == list ]]; then
  jq -r 'to_entries | map(select(.key | startswith("_") | not)) | sort_by(.key | tonumber? // 9999)[] | "\(.key)\t\(.value)"' "$FILE"
  exit 0
fi

[[ -n $ws ]] || ws=$(hyprctl activeworkspace -j | jq -r '.id')
[[ $ws =~ ^[0-9]+$ ]] || { echo "workspace-name: bad workspace id '$ws'" >&2; exit 1; }

peek() { omarchy-shell -q "$PLUGIN" showId "$ws" || true; }

if [[ $mode == peek ]]; then peek; exit 0; fi

write() { # $1 = jq filter
  local tmp; tmp=$(mktemp "${FILE}.XXXXXX")
  jq --arg id "$ws" --arg name "${name:-}" "$1" "$FILE" > "$tmp" && mv "$tmp" "$FILE"
}

if [[ $mode == clear ]]; then
  write 'del(.[$id])'
  peek
  exit 0
fi

if (($#)); then
  name="$*"
else
  # Preferred: the bar widget's inline editor (hover the number → click the
  # chip does the same). Returns "ok" only when the widget is live in the bar.
  if [[ $(omarchy-shell -q "$PLUGIN.bar" edit "$ws" 2>/dev/null) == ok ]]; then
    exit 0
  fi
  current=$(jq -r --arg id "$ws" '.[$id] // ""' "$FILE")
  prompt="Name workspace $ws"
  [[ -n $current ]] && prompt+=" (now: $current, empty clears)"
  if ! name=$(omarchy-menu-input "$prompt" --width 420); then
    exit 0 # cancelled
  fi
fi

name="${name#"${name%%[![:space:]]*}"}"; name="${name%"${name##*[![:space:]]}"}"
if [[ -z $name ]]; then
  write 'del(.[$id])'
else
  write '.[$id] = $name'
fi
peek
